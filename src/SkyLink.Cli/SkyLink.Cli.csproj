<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SkyLink.Core\SkyLink.Core.csproj" />
    <ProjectReference Include="..\SkyLink.Definitions\SkyLink.Definitions.csproj" />
    <ProjectReference Include="..\SkyLink.Net\SkyLink.Net.csproj" />
    <ProjectReference Include="..\SkyLink.Sim\SkyLink.Sim.csproj" />
    <ProjectReference Include="..\SkyLink.Session\SkyLink.Session.csproj" />
    <ProjectReference Include="..\SkyLink.Lobby\SkyLink.Lobby.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>skylink</AssemblyName>
    <RootNamespace>SkyLink.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\definitions\**\*.yaml" Link="definitions\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Microsoft's SimConnect.dll from the MSFS 2024 SDK, shipped next to the exe when present (see third_party/SimConnect). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\SimConnect\SimConnect.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\third_party\SimConnect\SimConnect.dll" Link="SimConnect.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
